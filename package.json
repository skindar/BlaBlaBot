{
  "name": "blablabot-web2",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "BlaBlaBot 2 — browser-native language tutor with a clean, testable core",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.2",
    "@mlc-ai/web-llm": "^0.2.87",
    "phonon-tts": "^0.6.0",
    "piper-tts-web": "^1.1.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.4",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^2.1.8",
    "jsdom": "^25.0.1",
    "tailwindcss": "^4.3.4",
    "typescript": "~5.6.2",
    "vite": "^5.4.10",
    "vitest": "^2.1.8"
  }
}
